{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "casa-tablet-backend",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-09",
  "durable_objects": {
    "bindings": [
      { "name": "HOME", "class_name": "HomeState" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["HomeState"] }
  ]
}